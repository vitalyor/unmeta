# From @BotFather
BOT_TOKEN=
# From https://my.telegram.org → API development tools (needed for files up to 2 GB)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Your Telegram user id: the only one who hears when the bot keeps falling or can't get up (press Start in its private chat once)
OWNER_ID=
# Optional: a URL to open every minute, e.g. from healthchecks.io. The only alarm that works if the whole server dies.
HEARTBEAT_URL=
# Optional: the largest file in MB (default 2000, the Telegram limit). Cleaning takes 2× the file on disk: lower it only if 2× the largest file plus 300 MB is not free.
MAX_FILE_MB=
